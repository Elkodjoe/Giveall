{
  "expo": {
    "name": "GiveAll",
    "slug": "giveall",
    "scheme": "giveall",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8F0",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.giveall.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["en", "es", "fr", "de", "pt", "zh-Hans", "ja"]
      }
    },
    "android": {
      "package": "com.giveall.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#B34B40"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "07c30b9d-f8e3-457a-9f6e-35fa457bc600"
      }
    },
    "owner": "elkodjoe1"
  }
}
