{
  "expo": {
    "name": "GiveAll",
    "slug": "giveall",
    "scheme": "giveall",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8F0",
    "splash": {
      "backgroundColor": "#FFF8F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.giveall.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.giveall.app"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "07c30b9d-f8e3-457a-9f6e-35fa457bc600"
      }
    },
    "owner": "elkodjoe1"
  }
}
