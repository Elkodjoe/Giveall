{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "lib"]
    }
  ],
  "hosting": [
    {
      "target": "marketing",
      "public": "marketing/public",
      "ignore": ["firebase.json", "**/.*"],
      "cleanUrls": true
    },
    {
      "target": "dashboard",
      "public": "dashboard/public",
      "ignore": ["firebase.json", "**/.*"]
    }
  ]
}
