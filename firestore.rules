rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Partner can read only after double opt-in
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/partnerships/$(request.auth.uid + '_' + userId)).data.status == 'active';
    }
    match /daily_checkins/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /action_logs/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /bids/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /memory_vault/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    // Double opt-in partner linking: doc id is "{uidA}_{uidB}" (sorted).
    // Not in the original handoff — added so the "active" status the
    // /profiles rule above checks is actually reachable. Both parties must
    // set their own opt-in field to true before status flips to 'active';
    // that flip must happen server-side (Cloud Function), never by direct
    // client write, so status is not listed as a client-writable field here.
    match /partnerships/{partnershipId} {
      allow read: if request.auth != null &&
        (request.auth.uid in resource.data.participants);
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.status == 'pending';
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['optIns']);
    }
    // Public read-only collections
    match /suggested_actions/{docId} {
      allow read: if request.auth != null;
    }
    match /curiosity_cards/{docId} {
      allow read: if request.auth != null;
    }
  }
}
