rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // partnerships doc ids are the two participant uids, lexicographically
    // sorted and joined with '_' (see partnershipId() in
    // src/firebase/collections.ts) — never "reader first". A rule that
    // builds the id as request.auth.uid + '_' + userId (unsorted) only
    // finds the doc when the reader's uid happens to sort first, silently
    // failing partner-read for the other ~50% of uid pairings. Compute the
    // sorted id here so every caller matches the actual storage convention.
    function partnershipDocId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Only "me" (whichever of the two participants is request.auth.uid) may
    // change my own optIns entry; the other participant's entry must stay
    // exactly what it already was. Without this, either party could write
    // BOTH keys of optIns to true in one update/create — spoofing the
    // partner's consent and defeating "double opt-in" entirely (the exact
    // trust promise app/settings.tsx's privacy copy makes). Confirmed this
    // was previously unenforced: affectedKeys().hasOnly(['optIns']) only
    // restricts which top-level field changes, not which map key inside it.
    function otherPartner(users, me) {
      return users[0] == me ? users[1] : users[0];
    }

    // Every user-owned collection below authorizes update/delete purely by
    // "does the EXISTING doc's userId match me" — but nothing stopped an
    // update from also changing userId. A user could create a doc as
    // themselves (passing the create check), then update it to
    // request.resource.data.userId = <victim>, planting fabricated data
    // (a fake bid, check-in, memory, action_log — action_logs feed the
    // recalibration logic in app/checkin.tsx, so this could even manipulate
    // a victim's stored love language) into another user's own reads.
    // curiosity_card_progress is worse: its doc id is "{userId}_{cardId}"
    // by convention, so an attacker could target the exact id the victim's
    // own client would read/write. Pin userId across every update.
    function ownedByMeAndUnchanged() {
      return request.auth.uid == resource.data.userId &&
        request.resource.data.userId == resource.data.userId;
    }

    // dashboard/public — read-only aggregate stats for the founder. Gated
    // on the signed-in Google account's verified email rather than a
    // custom claim, since setting custom claims needs a Cloud Function
    // (undeployed, Blaze deferred) — Firebase Auth already puts a verified
    // `email` claim on the ID token for Google Sign-In, so this needs no
    // backend. Single hardcoded address is deliberate for a single-founder
    // MVP; revisit if this ever needs more than one admin.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'emmakodjoe1@gmail.com';
    }

    // Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Partner can read only after double opt-in
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/partnerships/$(partnershipDocId(request.auth.uid, userId))).data.status == 'active';
      allow read: if isAdmin();
    }
    // NOTE on the create/read-update-delete split below: `resource.data` is
    // the *existing* document's state — on a create there is no existing
    // document yet, so `resource.data.userId` is always null and every
    // create was silently denied ("Missing or insufficient permissions").
    // Confirmed live against a real project on 2026-08-28, not just a
    // theoretical gap — `request.resource.data` (the incoming write) is the
    // one to check on create.
    match /daily_checkins/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && ownedByMeAndUnchanged();
      allow read: if isAdmin();
    }
    match /action_logs/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && ownedByMeAndUnchanged();
      allow read: if isAdmin();
    }
    // Append-only audit trail for docs/02-love-os-brain.md #3's "never
    // silently change loveLanguage" rule — see RecalibrationEventDoc in
    // src/firebase/types.ts. No update (once written, a recalibration event
    // is a historical fact) — but the owner CAN delete, so "delete my
    // account" (app/account.tsx) can wipe every trace of a user's data.
    match /recalibration_events/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow read: if isAdmin();
    }
    match /bids/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && ownedByMeAndUnchanged();
      allow read: if isAdmin();
    }
    match /memory_vault/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && ownedByMeAndUnchanged();
    }
    // CuriosityCardProgressDoc (src/firebase/types.ts) referenced this
    // collection but it had no rules of its own — same class of gap as
    // partnerships below. Doc id is "{userId}_{cardId}" for idempotent
    // upserts (see markCuriosityCardCompleted in collections.ts).
    match /curiosity_card_progress/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && ownedByMeAndUnchanged();
    }
    // DesireInventoryDoc (src/firebase/types.ts) — not in the original
    // handoff, no rules existed for this at all despite decisionMatrix.ts's
    // "sought" axis and docs/02-love-os-brain.md #2 depending on it.
    match /desire_inventory/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && ownedByMeAndUnchanged();
    }
    // Double opt-in partner linking: doc id is "{uidA}_{uidB}" (sorted).
    // Not in the original handoff — added so the "active" status the
    // /profiles rule above checks is actually reachable. Both parties must
    // set their own opt-in field to true before status flips to 'active';
    // that flip must happen server-side (Cloud Function), never by direct
    // client write, so status is not listed as a client-writable field here.
    match /partnerships/{partnershipId} {
      // resource is null when the doc doesn't exist yet (checking "has my
      // partner requested?" before either side has written anything) —
      // resource.data.users would then throw, and Firestore treats any
      // rule evaluation error as a deny. Short-circuit on resource == null
      // first. Same class of bug as the create/read split above, this time
      // on read of a maybe-nonexistent doc rather than create — confirmed
      // live via a two-browser-context test on 2026-08-28.
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.users);
      // The creator's own optIn may start true (requesting = auto opt-in),
      // but the other participant's must start false — otherwise the
      // creator could fabricate a fully-consented partnership in one write.
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.users &&
        request.resource.data.status == 'pending' &&
        request.resource.data.optIns[otherPartner(request.resource.data.users, request.auth.uid)] == false;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.users &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['optIns']) &&
        request.resource.data.optIns[otherPartner(resource.data.users, request.auth.uid)] ==
          resource.data.optIns[otherPartner(resource.data.users, request.auth.uid)];
      // Either participant may delete the partnership — used by "delete my
      // account" (app/account.tsx). Ending your account ends the link; the
      // other person's own data is untouched.
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }
    // Public read-only collections
    match /suggested_actions/{docId} {
      allow read: if request.auth != null;
    }
    match /curiosity_cards/{docId} {
      allow read: if request.auth != null;
    }
    // Public marketing site (marketing/public/index.html) email capture.
    // Unauthenticated by design — visitors aren't signed in. Create-only,
    // no read/update/delete: submitted emails aren't client-readable
    // (nothing should be able to scrape this list), and once written a
    // signup is a historical fact.
    match /waitlist_signups/{docId} {
      allow create: if request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.email.size() < 200 &&
        request.resource.data.email.matches('.+@.+[.].+');
      allow read: if isAdmin();
    }
  }
}
