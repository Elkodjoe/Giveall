rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Partner can read only after double opt-in
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/partnerships/$(request.auth.uid + '_' + userId)).data.status == 'active';
    }
    // NOTE on the create/read-update-delete split below: `resource.data` is
    // the *existing* document's state — on a create there is no existing
    // document yet, so `resource.data.userId` is always null and every
    // create was silently denied ("Missing or insufficient permissions").
    // Confirmed live against a real project on 2026-08-28, not just a
    // theoretical gap — `request.resource.data` (the incoming write) is the
    // one to check on create.
    match /daily_checkins/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /action_logs/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /bids/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /memory_vault/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    // CuriosityCardProgressDoc (src/firebase/types.ts) referenced this
    // collection but it had no rules of its own — same class of gap as
    // partnerships below. Doc id is "{userId}_{cardId}" for idempotent
    // upserts (see markCuriosityCardCompleted in collections.ts).
    match /curiosity_card_progress/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    // Double opt-in partner linking: doc id is "{uidA}_{uidB}" (sorted).
    // Not in the original handoff — added so the "active" status the
    // /profiles rule above checks is actually reachable. Both parties must
    // set their own opt-in field to true before status flips to 'active';
    // that flip must happen server-side (Cloud Function), never by direct
    // client write, so status is not listed as a client-writable field here.
    match /partnerships/{partnershipId} {
      // resource is null when the doc doesn't exist yet (checking "has my
      // partner requested?" before either side has written anything) —
      // resource.data.users would then throw, and Firestore treats any
      // rule evaluation error as a deny. Short-circuit on resource == null
      // first. Same class of bug as the create/read split above, this time
      // on read of a maybe-nonexistent doc rather than create — confirmed
      // live via a two-browser-context test on 2026-08-28.
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.users);
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.users &&
        request.resource.data.status == 'pending';
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.users &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['optIns']);
    }
    // Public read-only collections
    match /suggested_actions/{docId} {
      allow read: if request.auth != null;
    }
    match /curiosity_cards/{docId} {
      allow read: if request.auth != null;
    }
  }
}
