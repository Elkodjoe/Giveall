EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Appreciation Generator — live LLM output. Set this to the deployed
# Cloudflare Worker URL (see proxy/README.md); the key stays server-side,
# no Firebase Blaze plan needed. Without it the app falls back to Ollama
# (dev only) and then the static line.
# EXPO_PUBLIC_APPRECIATION_PROXY_URL=https://giveall-appreciation-proxy.<subdomain>.workers.dev
# Only if you set an APP_TOKEN secret on the Worker:
# EXPO_PUBLIC_APPRECIATION_PROXY_TOKEN=
# The same proxy URL also powers the "Hear it" button on the First Win
# screen (spoken appreciation) when the Worker has an ELEVENLABS_API_KEY
# secret — no extra app config needed.

# Optional — local Ollama fallback for the Appreciation Generator (see
# src/llm/ollamaClient.ts). Only used when running the app on the same
# machine as `ollama serve`. Defaults shown below; uncomment to override.
# EXPO_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434
# EXPO_PUBLIC_OLLAMA_MODEL=llama3.2:3b
